{
  "name": "comexsim-agrosim",
  "version": "0.1.0",
  "private": true,
  "description": "SIMA · AgroSim: demo frontend del simulador académico de agronegocios (propuesta para la UPSA).",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "lint": "eslint . && prettier --check .",
